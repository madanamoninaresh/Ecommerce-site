<%- include("./partials/header") %>

<!-- Local Font (Inter) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Inter', sans-serif !important;
        background: #f8f8f8;
        color: #1b1b1b;
    }
</style>

<div class="px-10 py-10">

    <div class="flex justify-between items-center mb-10">
        <h1 class="text-3xl font-semibold tracking-tight">Admin Dashboard</h1>
        <a href="/products/create"
           class="px-4 py-2 bg-black text-white rounded-lg hover:bg-gray-800 transition">
            + Add Product
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

        <% products.forEach(product => { %>

            <div class="bg-white rounded-2xl shadow hover:shadow-lg transition border border-gray-200">

                <div class="h-52 flex justify-center items-center rounded-t-2xl"
                     style="background:<%= product.bgcolor %>;">
                    <img src="<%= product.imageUrl %>" class="h-28 object-contain">
                </div>

                <div class="p-6" style="background: <%= product.panelcolor %>; color: <%= product.textcolor %>">
                    <h3 class="text-lg font-medium tracking-tight"><%= product.name %></h3>
                    <p class="text-sm mt-1">₹ <%= product.price %></p>

                    <div class="flex justify-between mt-5">
                        <a href="/products/edit/<%= product._id %>"
                           class="px-7 py-1 border rounded-md bg-white text-zinc-500 hover:bg-gray-100 transition">
                            Edit
                        </a>

                        <a href="/products/delete/<%= product._id %>"
                           class="px-5 py-1 rounded-md bg-red-500 text-white-300 hover:bg-Zinc-600 transition">
                            Delete
                        </a>
                    </div>
                </div>

            </div>

        <% }) %>

    </div>

</div>

<%- include("./partials/footer") %>
