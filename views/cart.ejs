<div class="px-20 py-10">
    
    <% if (user.products.length === 0) { %>
        <h2 class="text-2xl text-center text-gray-600 mt-20">Your cart is empty.</h2>
    <% } %>

    <% user.products.forEach(function(item){ %>

    <div class="w-full flex items-start gap-10 mb-16">

        <!-- LEFT SIDE PRODUCT BOX -->
        <div class="w-[30%] rounded-md overflow-hidden shadow border">

            <!-- Image section -->
            <div class="w-full flex justify-center items-center h-80" style="background: <%= item.productId.bgcolor %>";>
                <img class="h-[12rem]" src="<%= item.productId.imageUrl %>" alt="">
            </div>

            <!-- Title + Quantity Buttons -->
            <!-- style="color: <%= item.productId.textcolor %>"; -->
            <div class="w-full px-5 py-4 flex justify-between items-center" style="background: <%= item.productId.panelcolor %>">
                <h3 class="text-xl font-semibold" style="color: <%= item.productId.textcolor %>;">
                    <%= item.productId.name %>
                </h3>


                <div class="flex items-center gap-3">

                    <!-- Increase -->
                    <a href="/cart/increase/<%= item.productId._id %>"
                       class="w-7 h-7 bg-white flex rounded-full items-center justify-center shadow">
                        <i class="ri-add-line"></i>
                    </a>

                    <div class="px-2 py-1 bg-white rounded-md text-black">
                        <%= item.quantity %>
                    </div>

                    <!-- Decrease -->
                    <a href="/cart/decrease/<%= item.productId._id %>"
                       class="w-7 h-7 bg-white flex rounded-full items-center justify-center shadow">
                        <i class="ri-subtract-line"></i>
                    </a>
                    <div class="px-5 py-3 text-right">
                <a href="/cart/remove/<%= item.productId._id %>"
                   class="text-zinc-700 text-sm hover:underline">
                    Remove
                </a>
            </div>

                </div>

            </div>

            <!-- Remove -->
            <!-- <div class="px-5 py-3 text-right">
                <a href="/cart/remove/<%= item.productId._id %>"
                   class="text-red-600 text-sm hover:underline">
                    Remove
                </a>
            </div> -->

            <!-- Net Total Box -->
            <!-- style="background: <%= item.productId.textcolor %>"> -->
            <div class="flex justify-between px-5 py-3 text-white" style="background: <%= item.productId.textcolor %>">
                <h4 class="text-lg">Net Total</h4>

                <% const bill = (item.productId.price + platformFee - item.productId.discount) * item.quantity %>

                <h2 class="text-lg font-semibold">₹ <%= bill %></h2>
            </div>

        </div>

        <!-- RIGHT SIDE PRICE BREAKDOWN -->
        <div class="w-[70%] shadow rounded-md p-7 bg-white border">

            <h3 class="text-xl font-semibold mb-4">Price Breakdown</h3>

            <div class="space-y-3 text-gray-700">

                <div class="flex justify-between">
                    <span>Total MRP</span>
                    <span>₹ <%= item.productId.price * item.quantity %></span>
                </div>

                <div class="flex justify-between">
                    <span>Discount</span>
                    <span>- ₹ <%= item.productId.discount * item.quantity %></span>
                </div>

                <div class="flex justify-between">
                    <span>Platform Fee</span>
                    <span>₹ <%= platformFee %></span>
                </div>

                <div class="flex justify-between">
                    <span>Shipping Fee</span>
                    <span class="text-green-600 font-medium">FREE</span>
                </div>

            </div>

            <div class="w-full h-[1px] bg-gray-300 my-5"></div>

            <div class="flex justify-between text-xl font-semibold">
                <span>Total Amount</span>
                <span class="text-green-600">₹ <%= bill %></span>
            </div>

        </div>

    </div>

    <% }) %>
    <div class="flex justify-between text-xl font-semibold">
                <span>Total Amount</span>
                <span class="text-green-600">₹ <%= grandTotal %></span>
            </div>

</div>

