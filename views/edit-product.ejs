<%- include("./partials/header") %>

<!-- Import Inter Font Locally -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Inter', sans-serif;
        background: #f8f8f8;
        color: #2d2d2d;
    }
</style>


<style>
    body {
        font-family: 'Inter', sans-serif !important;
        background: #f7f7f7;
        color: #1b1b1b;
    }
</style>

<div class="px-6 py-10 max-w-3xl mx-auto">

    <!-- Page Title -->
    <h1 class="text-3xl font-semibold tracking-tight mb-10 text-zinc-800">
        Edit Product
    </h1>

    <!-- Form Container -->
    <form action="/products/update/<%= product._id %>"
          method="POST"
          enctype="multipart/form-data"
          class="bg-white rounded-2xl shadow-md border border-gray-200 p-10 space-y-8">

        <!-- SECTIONS IMPROVED WITH TITLE -->
        <h2 class="text-lg font-medium text-gray-700 pb-2 border-b">Product Details</h2>

        <!-- Name + Price -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">Product Name</label>
                <input name="name"
                       value="<%= product.name %>"
                       class="border rounded-lg p-3 w-full bg-gray-50 focus:ring-2 focus:ring-black/30 outline-none" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">Price</label>
                <input name="price" type="number"
                       value="<%= product.price %>"
                       class="border rounded-lg p-3 w-full bg-gray-50 focus:ring-2 focus:ring-black/30 outline-none" />
            </div>
        </div>

        <!-- DISCOUNT + CATEGORY -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">Discount</label>
                <input name="discount" type="number"
                       value="<%= product.discount %>"
                       class="border rounded-lg p-3 w-full bg-gray-50 focus:ring-2 focus:ring-black/30 outline-none" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">Category</label>
                <input name="category"
                       value="<%= product.category %>"
                       class="border rounded-lg p-3 w-full bg-gray-50 focus:ring-2 focus:ring-black/30 outline-none" />
            </div>
        </div>

        <h2 class="text-lg font-medium text-gray-700 pb-2 border-b">Appearance</h2>

        <!-- COLOR INPUTS -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">Background Color</label>
                <input name="bgcolor"
                       value="<%= product.bgcolor %>"
                       class="border rounded-lg p-3 w-full bg-gray-50 focus:ring-2 focus:ring-black/30 outline-none" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">Panel Color</label>
                <input name="panelcolor"
                       value="<%= product.panelcolor %>"
                       class="border rounded-lg p-3 w-full bg-gray-50 focus:ring-2 focus:ring-black/30 outline-none" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1">Text Color</label>
                <input name="textcolor"
                       value="<%= product.textcolor %>"
                       class="border rounded-lg p-3 w-full bg-gray-50 focus:ring-2 focus:ring-black/30 outline-none" />
            </div>

        </div>

        <!-- Image Section -->
        <h2 class="text-lg font-medium text-gray-700 pb-2 border-b">Image</h2>

        <div class="space-y-4">
            <p class="text-sm text-gray-600">Current Image:</p>

            <div class="border rounded-lg p-3 bg-gray-50 flex justify-center">
                <img src="<%= product.imageUrl %>" class="h-40 object-contain" />
            </div>

            <label class="block text-sm font-medium text-gray-600">Upload New Image (optional)</label>
            <input name="image" type="file" class="w-full" />
        </div>

        <!-- Update Button -->
        <button class="w-full py-3 rounded-lg bg-black text-white font-medium hover:bg-gray-800 transition">
            Save Changes
        </button>

    </form>

</div>

<%- include("./partials/footer") %>
